# FinWise AI Environment Configuration
# Copy this file to .env and configure values before starting the application.

# App Settings
PROJECT_NAME="FinWise AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY="replace-with-a-secure-random-secret-key-finwise-ai-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite file finwise.db for zero-friction local setup
DATABASE_URL="sqlite:///./finwise.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finwise_db"

# LLM / AI Finance Assistant Configuration
# FinWise AI provides a 100% functional rule-based fallback assistant if no key is provided.
# Supported providers: "gemini", "openai", "groq", or "fallback"
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# CORS Settings (frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
